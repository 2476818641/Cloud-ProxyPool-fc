[aliyun]
access_key_id = "YOUR_ACCESS_KEY_ID"
access_key_secret = "YOUR_ACCESS_KEY_SECRET"

[deployment]
# Optional fallback for non-interactive runs.
# Interactive mode will prompt you to choose groups instead of editing this list.
regions = ["cn-shanghai", "cn-hangzhou", "cn-beijing", "cn-shenzhen"]
function_name = "cloud_proxy_pool_func"
handler = "index.handler"
runtime = "python3.10"
timeout = 60
memory_size = 512
trigger_name = "http_trigger"
auth_type = "anonymous"
internet_access = true
description = "Cloud ProxyPool over Alibaba Cloud Function Compute"

[health_check]
enable = true
test_url = "http://myip.ipip.net"
expected_status = 200
